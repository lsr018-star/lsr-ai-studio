# Copy to .env and fill in. Never commit a real .env.
#
# --- vLLM (only needed if you run the GPU model service) ---
# Hugging Face token. Needed for gated models; public models like
# Qwen2.5-Coder work without one, but a token raises rate limits.
HF_TOKEN=

# Which open-weights model vLLM serves. 7B-class models fit on a
# single 16GB GPU; 70B-class needs ~40GB+ (A100/H100 tier).
VLLM_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct

# --- LiteLLM gateway ---
# This becomes the API key you paste into the Studio's
# "Custom OpenAI-compatible" provider. Change it.
LITELLM_MASTER_KEY=sk-lsr-change-me

# Optional: used only if you enable the OpenRouter route in
# litellm-config.yaml instead of running vLLM.
OPENROUTER_API_KEY=
